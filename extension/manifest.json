{
  "manifest_version": 3,
  "name": "KU Exchange CBA Syllabus Importer",
  "version": "1.0.0",
  "description": "For KU Exchange coordinators: imports CBA subjects and their syllabi from the CBA syllabus site into the KU Exchange portal.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://isom472-fall2026.github.io/team2/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://cmu-cba.ku.edu.kw/*"],
      "js": ["cba.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-48.png"],
      "matches": ["https://cmu-cba.ku.edu.kw/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cba-syllabus-importer@isom472-team2",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
